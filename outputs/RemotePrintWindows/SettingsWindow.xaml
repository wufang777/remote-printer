<Window x:Class="RemotePrintWindows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="接入配置" Width="520" Height="500" WindowStartupLocation="CenterOwner" Background="#F4F9FF"><StackPanel Margin="28"><TextBlock Text="接入配置" FontSize="24" FontWeight="Bold" Foreground="#10234A"/><TextBlock Text="保存后用于连接远程打印平台；内容保存在当前 Windows 用户配置目录。" TextWrapping="Wrap" Foreground="#51698F" Margin="0,6,0,18"/><TextBlock Text="API 地址"/><TextBox x:Name="ApiBox"/><TextBlock Text="设备名称" Margin="0,12,0,0"/><TextBox x:Name="DeviceBox"/><TextBlock Text="注册码" Margin="0,12,0,0"/><TextBox x:Name="CodeBox"/><TextBlock Text="默认打印模式" Margin="0,12,0,0"/><ComboBox x:Name="BehaviorBox"><ComboBoxItem Content="打印前确认"/><ComboBoxItem Content="静默打印"/></ComboBox><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Content="取消" Click="Cancel" Height="44"/><Button Content="保存配置" Click="Save" Height="44"/></StackPanel></StackPanel></Window>
