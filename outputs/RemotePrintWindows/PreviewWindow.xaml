<Window x:Class="RemotePrintWindows.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="文件预览" Width="1100" Height="760" WindowStartupLocation="CenterOwner" Background="#F4F9FF">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><TextBlock x:Name="TitleText" Text="文件预览" FontSize="22" FontWeight="Bold" Foreground="#10234A"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="−" Click="ZoomOut"/><TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Margin="10,0"/><Button Content="+" Click="ZoomIn"/><Button Content="关闭" Click="CloseWindow"/></StackPanel></DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="18" Padding="16"><Grid><ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="None" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="ImageScale"/></Image.RenderTransform></Image></ScrollViewer><StackPanel x:Name="PdfPanel" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="PDF 预览将使用 Windows 默认 PDF 阅读器打开" FontSize="18" Foreground="#10234A"/><TextBlock Text="请在测试电脑安装 Microsoft Edge 或 Adobe Acrobat Reader。" Margin="0,8" Foreground="#51698F"/><Button Content="打开 PDF 预览" Click="OpenPdf"/></StackPanel></Grid></Border>
  </Grid>
</Window>
