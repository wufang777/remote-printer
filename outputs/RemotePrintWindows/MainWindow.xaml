<Window x:Class="RemotePrintWindows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="远程打印控制台" Width="1440" Height="900" MinWidth="1120" MinHeight="760" Background="#F4F9FF">
  <Window.Resources>
    <LinearGradientBrush x:Key="Aurora" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2675FF"/><GradientStop Color="#35C8F7" Offset="1"/></LinearGradientBrush>
    <Style TargetType="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="14,7"/><Setter Property="Margin" Value="4"/></Style>
  </Window.Resources>
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource Aurora}"><TextBlock Text="▣" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#071A3D"/></Border><StackPanel Margin="16,0"><TextBlock Text="远程打印控制台" FontSize="28" FontWeight="Bold" Foreground="#10234A"/><TextBlock Text="本机设备 · 实时任务通道" Foreground="#51698F" FontSize="15"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Border Background="#E0FFF3" CornerRadius="20" Padding="14,8" Margin="4"><TextBlock Text="● 系统在线" Foreground="#138461" FontWeight="Bold"/></Border><Button Content="⚙ 接入配置" Click="OpenSettings"/></StackPanel></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#EEFFFFFF" CornerRadius="22" Padding="24" Margin="0,0,22,22"><StackPanel><TextBlock Text="创建打印任务" FontSize="22" FontWeight="Bold" Foreground="#10234A"/><TextBlock Text="选择文件和目标设备，安全下发本地打印。" Margin="0,4,0,18" Foreground="#51698F"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="内容类型"/><ComboBox x:Name="TypeBox" SelectedIndex="0"><ComboBoxItem Content="PDF 文档"/><ComboBoxItem Content="图片"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="目标打印机"/><ComboBox x:Name="PrinterBox"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><RadioButton x:Name="ConfirmMode" Content="打印前确认" IsChecked="True" Margin="0,0,16,0"/><RadioButton x:Name="SilentMode" Content="静默打印"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="选择本地文件" Click="ChooseFile"/><TextBlock x:Name="FileNameText" VerticalAlignment="Center" Text="尚未选择 PDF 或图片文件" Foreground="#51698F" Margin="10,0"/><Button Content="预览" Click="PreviewFile"/><Button Content="删除" Click="ClearFile"/></StackPanel><Button Content="⚡ 发送打印任务" Background="{StaticResource Aurora}" Foreground="#071A3D" FontWeight="Bold" Click="CreateTask" Margin="0,16,0,0"/></StackPanel></Border>
      <StackPanel Grid.Column="1"><Border Background="#EEFFFFFF" CornerRadius="22" Padding="24" Margin="0,0,0,22"><TextBlock Text="设备状态" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="DeviceText" Text="未选择设备" FontSize="20" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="● 已连接 · 低延迟" Foreground="#138461"/></Border><Border Background="#EEFFFFFF" CornerRadius="22" Padding="24"><TextBlock Text="今日任务" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="CountText" Text="0" FontSize="44" FontWeight="Bold" Foreground="#2675FF"/><TextBlock Text="已进入本机任务通道" Foreground="#51698F"/></Border></StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="#EEFFFFFF" CornerRadius="22" Padding="24"><DockPanel><TextBlock DockPanel.Dock="Top" Text="最近任务" FontSize="22" FontWeight="Bold" Foreground="#10234A" Margin="0,0,0,14"/><ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="14" Padding="16" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="Bold"/><TextBlock Text="{Binding PrinterName}" Foreground="#51698F"/><TextBlock Text="{Binding StatusLabel}" Foreground="#138461" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="预览" Tag="{Binding}" Click="PreviewTask"/><Button Content="确认打印" Tag="{Binding}" Click="ConfirmTask"/><Button Content="取消" Tag="{Binding}" Click="CancelTask"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
  </Grid>
</Window>
